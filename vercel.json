{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/#pricing",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/app.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },

    { "source": "/blog", "destination": "/app.html" },
    { "source": "/blog/:slug", "destination": "/app.html" },
    { "source": "/faq", "destination": "/app.html" },
    { "source": "/help", "destination": "/app.html" },
    { "source": "/contact", "destination": "/app.html" },
    { "source": "/privacy", "destination": "/app.html" },
    { "source": "/terms", "destination": "/app.html" },
    { "source": "/cookies", "destination": "/app.html" },
    { "source": "/data-protection", "destination": "/app.html" },

    { "source": "/question/:id", "destination": "/app.html" },
    { "source": "/question-unknown/:id", "destination": "/app.html" },
    { "source": "/auth", "destination": "/app.html" },
    { "source": "/auth/google/callback", "destination": "/app.html" },
    { "source": "/register", "destination": "/app.html" },
    { "source": "/forgot-password", "destination": "/app.html" },
    { "source": "/signup-flow", "destination": "/app.html" },
    { "source": "/pgs/ref/:slug", "destination": "/app.html" },

    { "source": "/mock-interview", "destination": "/app.html" },
