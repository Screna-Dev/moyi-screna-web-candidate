    { "source": "/ai-mock", "destination": "/app.html" },
    { "source": "/ai-mockwhite", "destination": "/app.html" },
    { "source": "/evaluation", "destination": "/app.html" },
    { "source": "/add-experience", "destination": "/app.html" },

    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/dashboard/contributions", "destination": "/app.html" },
    { "source": "/profile", "destination": "/app.html" },
    { "source": "/contributions", "destination": "/app.html" },
    { "source": "/refer", "destination": "/app.html" },
    { "source": "/history", "destination": "/app.html" },
